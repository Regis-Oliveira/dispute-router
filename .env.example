# Postgres runs on 5433 because 5432 is usually already taken on this machine.
DATABASE_URL=postgres://dispute:dispute@localhost:5433/dispute_router
REDIS_URL=redis://localhost:6379

# Where the simulator posts webhooks once the Go ingest service exists (Phase 1).
INGEST_URL=http://localhost:8080/webhooks/processor

# Volume knobs for `seed`.
SEED=42
SEED_MERCHANTS=9
SEED_TRANSACTIONS=500000
SEED_DISPUTE_RATE=0.02

# LocalStack. The same variables point at real AWS by clearing AWS_ENDPOINT_URL
# and letting the SDK find credentials the normal way (env, shared config, or an
# instance role) - a long-lived key in a file is the credential that ends up in
# a git history.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/disputes-events
S3_EVIDENCE_BUCKET=dispute-evidence

# Webhook signing keys. "database" reads merchants.webhook_secret and needs no
# AWS at all; "secretsmanager" reads one document holding every merchant's keys.
# The TTL is the real rotation latency: a key published now takes effect within
# it, so minutes rather than hours.
WEBHOOK_SECRET_SOURCE=secretsmanager
WEBHOOK_SECRET_ID=dispute-router/webhook-secrets
WEBHOOK_SECRET_TTL=5m
SQS_DLQ_URL=http://localhost:4566/000000000000/disputes-events-dlq
