# Postgres runs on 5433 because 5432 is usually already taken on this machine.
DATABASE_URL=postgres://dispute:dispute@localhost:5433/dispute_router
REDIS_URL=redis://localhost:6379

# Where the simulator posts webhooks once the Go ingest service exists (Phase 1).
INGEST_URL=http://localhost:8080/webhooks/processor

# Volume knobs for `seed`.
SEED=42
SEED_MERCHANTS=9
SEED_TRANSACTIONS=500000
SEED_DISPUTE_RATE=0.02

# LocalStack. The same variables point at real AWS by clearing AWS_ENDPOINT_URL
# and letting the SDK find credentials the normal way (env, shared config, or an
# instance role) - a long-lived key in a file is the credential that ends up in
# a git history.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/disputes-events
S3_EVIDENCE_BUCKET=dispute-evidence

# Webhook signing keys. "database" reads merchants.webhook_secret and needs no
# AWS at all; "secretsmanager" reads one document holding every merchant's keys.
# The TTL is the real rotation latency: a key published now takes effect within
# it, so minutes rather than hours.
WEBHOOK_SECRET_SOURCE=secretsmanager
WEBHOOK_SECRET_ID=dispute-router/webhook-secrets
WEBHOOK_SECRET_TTL=5m
SQS_DLQ_URL=http://localhost:4566/000000000000/disputes-events-dlq

# ---------------------------------------------------------------------------
# The representment assistant
# ---------------------------------------------------------------------------
#
# Two providers. "anthropic" needs only a key and is what to use on a laptop;
# "bedrock" needs an AWS account with model access and takes its credentials
# from the task role, which is the right shape in production.
#
# ANTHROPIC_API_KEY comes from console.anthropic.com. A claude.ai subscription
# is a separate product with separate billing and cannot be used here.
#
# Leave the key out of this file if you prefer - the process reads the
# environment first, so `ANTHROPIC_API_KEY=... go run ./cmd/eval` works and
# nothing is written to disk. Never pass it as a command-line flag: flags land
# in shell history and in the output of ps.
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Bedrock ids are region-scoped and versioned; list them with
#   aws bedrock list-foundation-models --query 'modelSummaries[].modelId'
BEDROCK_MODEL_ID=

# Per dispute, across the generator and the verifier, in micro-dollars.
# 250000 = $0.25. An automation that costs more than the chargeback it works on
# has inverted its own business case.
AGENT_MAX_COST_MICROS=250000
AGENT_MAX_ATTEMPTS=2
AGENT_BATCH_SIZE=5

# Token prices in micro-dollars per million tokens. Check the current rates for
# the model above - these are a starting point, not a quote, and every cost this
# system reports is only as right as they are.
AGENT_INPUT_MICROS_PER_MTOK=3000000
AGENT_OUTPUT_MICROS_PER_MTOK=15000000

# Precedent retrieval. Anthropic does not serve embeddings, so this is a second
# provider. Leave the key empty and the retriever falls back to Postgres
# full-text search - which is the baseline a vector index has to beat, and for
# short claims in one language that is a genuinely open contest.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
PRECEDENT_LIMIT=3
